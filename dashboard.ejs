<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Nike Capsule Admin Control Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: rgb(67, 54, 99); }
        .serif-title { font-family: 'Playfair Display', serif; }
        .nike-glass-panel { background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.15); box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15); }
        .nike-glass-input { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff; transition: all 0.25s ease; }
        .nike-glass-input:focus { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.6); outline: none; }
        .nike-glass-input::placeholder { color: rgba(255, 255, 255, 0.5); }
        select.nike-glass-dropdown, select.nike-glass-dropdown option { background-color: rgb(45, 36, 68) !important; color: #ffffff !important; }
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 10px; }
        select option { background-color: rgb(67, 54, 99); color: white; }

        /* Custom Checkbox for Mobile Compatibility */
        input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 4px;
            cursor: pointer;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        input[type="checkbox"]:checked {
            background-color: white;
            border-color: white;
        }
        input[type="checkbox"]:checked::after {
            content: '✓';
            color: black;
            font-size: 12px;
            font-weight: 900;
            position: absolute;
        }
    </style>
</head>
<body class="text-white min-h-screen relative overflow-x-hidden pb-12">

    <div id="deleteConfirmModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[9999] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="nike-glass-panel p-6 rounded-3xl max-w-sm w-full mx-4 text-center transform scale-90 transition-transform duration-300">
            <div class="text-3xl mb-2">🗑️</div>
            <h3 class="text-xl font-bold text-white mb-2">Delete Product?</h3>
            <p class="text-xs text-white/80 font-medium leading-relaxed mb-6">Are you sure you want to remove this product? This action cannot be undone.</p>
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()" class="w-1/2 bg-white/10 hover:bg-white/20 text-white font-bold py-2.5 rounded-xl text-xs uppercase">Cancel</button>
                <a id="confirmDeleteBtn" href="#" class="w-1/2 bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-xl text-xs uppercase text-center flex items-center justify-center">Delete</a>
            </div>
        </div>
    </div>

    <div id="customModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[9999] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="nike-glass-panel p-6 rounded-3xl max-w-sm w-full mx-4 text-center transform scale-90 transition-transform duration-300" id="modalBox">
            <div class="text-3xl mb-2" id="modalIcon">✨</div>
            <h3 class="text-xl font-bold text-white mb-2" id="modalTitle">Notification</h3>
            <p class="text-xs text-white/80 font-medium leading-relaxed mb-6" id="modalMessage">Content...</p>
            <button onclick="closeCustomModal()" class="w-full bg-white text-black font-bold py-2.5 px-5 rounded-xl text-xs uppercase tracking-widest hover:bg-gray-100 transition-colors shadow-md">Okay, Got It</button>
        </div>
    </div>

    <div id="sizePromptModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[9998] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="nike-glass-panel p-6 rounded-3xl max-w-sm w-full mx-4 transform scale-90 transition-transform duration-300" id="sizePromptBox">
            <div class="text-2xl mb-2 text-center">📏</div>
            <h3 class="text-lg font-bold text-white mb-2 text-center">Add Custom Size</h3>
            <p class="text-xs text-white/60 mb-4 text-center">Enter size label name (e.g., 11, 7.5, XXL, 36)</p>
            <input type="text" id="customSizeInputField" placeholder="Type size here..." class="w-full p-3 rounded-xl nike-glass-input text-xs text-center mb-4">
            <div class="flex gap-3">
                <button onclick="closeSizePromptModal()" class="w-1/2 bg-white/10 hover:bg-white/20 text-white font-bold py-2 rounded-xl text-xs uppercase transition-colors">Cancel</button>
                <button onclick="submitCustomSizeFromModal()" class="w-1/2 bg-white text-black font-bold py-2 rounded-xl text-xs uppercase hover:bg-gray-100 transition-colors">Inject Size</button>
            </div>
        </div>
    </div>

    <nav class="border-b border-white/10 px-6 py-5 flex justify-between items-center backdrop-blur-md bg-white/5">
        <div class="flex items-center gap-3">
            <div class="serif-title text-2xl font-black tracking-wide text-white">Capsule Control</div>
            <span class="text-[10px] font-bold tracking-widest bg-white/10 text-white border border-white/20 px-2 py-0.5 rounded-md uppercase">Admin Panel</span>
        </div>
        <div class="flex items-center gap-4">
            <a href="/admin/logout" class="bg-white/10 hover:bg-white/20 border border-white/10 text-white px-4 py-2 rounded-xl text-xs font-bold transition-all duration-300">Logout</a>
        </div>
    </nav>

    <div class="p-4 md:p-6 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 mt-4">
        
        <div class="nike-glass-panel p-5 md:p-6 rounded-2xl h-fit flex flex-col gap-4">
            <div>
                <h3 class="text-2xl font-bold text-white serif-title">Add Capsule Item</h3>
                <p class="text-xs text-white/60 mt-1">Push new dynamic catalog assets directly to the live feed.</p>
            </div>
            
            <form action="/admin/add-product" method="POST" enctype="multipart/form-data" id="productForm" onsubmit="setTimeout(() => openCustomModal('✅', 'Success', 'Product Published!'), 500)" class="flex flex-col gap-4 text-xs mt-2">
                <div>
                    <label class="block text-white/80 font-medium mb-1">Product Title</label>
                    <input type="text" name="title" placeholder="Nike Bowerman Sneaker" required class="w-full p-2.5 rounded-xl nike-glass-input">
                </div>

                <div class="bg-white/5 p-3 rounded-xl border border-white/10 flex flex-col gap-2">
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-white/80 font-semibold text-xs">Product Gallery (Max 5 Images)</label>
                        <button type="button" onclick="addNewImageField()" class="text-[11px] bg-white/10 border border-white/20 hover:bg-white/20 text-white px-2 py-1 rounded-md font-bold transition-all">
                            ➕ Add More Image
                        </button>
                    </div>
                    
                    <div id="image-inputs-container" class="flex flex-col gap-2">
                        <div class="flex gap-2 items-center">
                            <input type="file" name="images" accept="image/*" required class="w-full p-2 rounded-xl nike-glass-input text-xs cursor-pointer file:hidden">
                            <span class="text-gray-400 text-[10px] px-2 font-bold select-none">Main</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-white/80 font-medium mb-1">Base Price (₹)</label>
                        <input type="number" name="price" placeholder="8999" required class="w-full p-2.5 rounded-xl nike-glass-input">
                    </div>
                    <div>
                        <label class="block text-white/80 font-medium mb-1">Discount (%)</label>
                        <input type="number" name="discount" value="0" class="w-full p-2.5 rounded-xl nike-glass-input">
                    </div>
                </div>

                <div>
                    <label class="block text-white/80 font-medium mb-1">Target Catalog (Gender)</label>
                    <select name="gender" class="w-full p-2.5 rounded-xl nike-glass-input font-medium text-sm nike-glass-dropdown">
                        <option value="male">👨 Male / Men</option>
                        <option value="female">👩 Female / Women</option>
                        <option value="boy">👦 Boy / Kids</option>
                        <option value="girl">👧 Girl / Kids</option>
                    </select>
                </div>

                <div>
                    <label class="block text-white/80 font-medium mb-1">Product Category Type</label>
                    <select name="category" onchange="toggleSizeLayout(this.value)" class="w-full p-2.5 rounded-xl nike-glass-input font-medium text-sm nike-glass-dropdown">
                        <optgroup label="Footwear & Sneakers">
                            <option value="shoes">Shoes & Sneakers</option>
                        </optgroup>
                        <optgroup label="Upper Body Clothes">
                            <option value="jackets">Jackets / Coats</option>
                            <option value="tshirts">T-Shirts / Tops</option>
                            <option value="hoodies">Hoodies / Sweatshirts</option>
                        </optgroup>
                        <optgroup label="Lower Body Clothes">
                            <option value="pants">Pants / Jeans</option>
                            <option value="shorts">Shorts / Boxers</option>
                        </optgroup>
                    </select>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block font-semibold text-white text-sm">Select Stock Sizes</label>
                        <button type="button" onclick="openSizePromptModal()" class="flex items-center gap-1 text-white hover:opacity-80 font-bold transition-all duration-300">
                            <span class="text-xs">➕</span> <span class="text-[11px] underline tracking-wide">Add Size</span>
                        </button>
                    </div>
                    
                    <div id="shoe-sizes" class="grid grid-cols-4 gap-2 bg-white/5 p-2.5 rounded-xl border border-white/10">
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="6" class="w-4 h-4"> 6</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="7" class="w-4 h-4"> 7</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="8" class="w-4 h-4"> 8</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="9" class="w-4 h-4"> 9</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="10" class="w-4 h-4"> 10</label>
                    </div>

                    <div id="alpha-sizes" class="hidden grid grid-cols-4 gap-2 bg-white/5 p-2.5 rounded-xl border border-white/10">
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="S" disabled class="w-4 h-4"> S</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="M" disabled class="w-4 h-4"> M</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="L" disabled class="w-4 h-4"> L</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="XL" disabled class="w-4 h-4"> XL</label>
                    </div>

                    <div id="numeric-sizes" class="hidden grid grid-cols-4 gap-2 bg-white/5 p-2.5 rounded-xl border border-white/10">
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="28" disabled class="w-4 h-4"> 28</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="30" disabled class="w-4 h-4"> 30</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="32" disabled class="w-4 h-4"> 32</label>
                        <label class="flex items-center gap-1.5 font-medium cursor-pointer"><input type="checkbox" name="sizes" value="34" disabled class="w-4 h-4"> 34</label>
                    </div>

                    <div id="custom-sizes-container" class="mt-2 grid grid-cols-2 gap-2 bg-white/10 p-2 rounded-xl border border-dashed border-white/30 hidden">
                    </div>
                </div>

                <div>
                    <label class="block text-white/80 font-medium mb-1">Product Description</label>
                    <textarea name="description" placeholder="Premium fabric matrix or sole details..." required rows="3" class="w-full p-2.5 rounded-xl nike-glass-input"></textarea>
                </div>

                <button type="submit" class="bg-white text-black font-bold p-3.5 rounded-xl text-xs uppercase tracking-widest hover:bg-gray-100 transition-all duration-300 shadow-md mt-2 serif-title text-center block w-full">Publish to Live Store</button>
            </form>
        </div>

        <div class="lg:col-span-2 flex flex-col gap-4">
            <div class="border-b border-white/10 pb-2 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                <h3 class="text-xl font-bold text-white tracking-wide serif-title">Live Inventory Feed (<%= products.length %> items)</h3>
                <div class="relative w-full sm:max-w-xs">
                    <input type="text" id="catalogSearchInput" onkeyup="searchCatalogByTitle()" placeholder="🔍 Search products by title or category..." class="w-full p-2 rounded-xl nike-glass-input text-xs">
                </div>
            </div>
            
            <div id="catalogFeedContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[82vh] overflow-y-auto pr-1 custom-scroll">
                <% products.forEach(product => { %>
                    <div class="catalog-product-card nike-glass-panel p-4 rounded-xl flex gap-4 relative border border-white/10 group hover:border-white/30 transition-all">
                        <button type="button" onclick="showDeleteConfirm('<%= product._id %>')" class="absolute top-3 right-3 text-white/40 hover:text-red-400 text-sm transition-colors z-10" title="Delete Product">❌</button>
                        
                        <div class="w-20 h-20 bg-white/5 rounded-xl flex items-center justify-center overflow-hidden border border-white/5 group-hover:scale-105 transition-transform shrink-0">
                            <img src="<%= product.image || '/uploads/default.jpg' %>" alt="Product" class="w-full h-full object-cover">
                        </div>
                        <div class="flex flex-col gap-1 text-xs w-full">
                            <h4 class="product-title-text text-sm font-bold text-white tracking-wide pr-5"><%= product.title %></h4>
                            <p class="category-tag text-white/60 capitalize font-medium">Tag: <span class="bg-white/10 border border-white/10 text-white px-1.5 py-0.5 rounded text-[9px]"><%= product.gender %></span> • <span class="bg-white/10 border border-white/10 text-white px-1.5 py-0.5 rounded text-[9px]"><%= product.category %></span></p>
                            
                            <div class="mt-1 flex flex-wrap gap-1 items-center">
                                <span class="text-white/50 font-semibold text-[10px]">Sizes:</span>
                                <% if(product.sizes && product.sizes.length > 0) { %>
                                    <% product.sizes.forEach(sz => { %>
                                        <span class="bg-white/20 border border-white/10 text-white font-bold px-1.5 py-0.5 rounded text-[9px]"><%= sz %></span>
                                    <% }) %>
                                <% } %>
                            </div>

                            <p class="text-base font-bold text-white mt-2">₹<%= product.price %> <span class="text-yellow-300 text-xs">(<%= product.discount %>% Off)</span></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="p-4 md:p-6 max-w-7xl mx-auto mt-8">
        <div class="nike-glass-panel p-5 md:p-6 rounded-2xl flex flex-col gap-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-4">
                <div>
                    <h3 class="text-2xl font-bold text-white serif-title">Live Orders Center</h3>
                    <p class="text-xs text-white/60 mt-1">Track incoming client checkouts and customer details.</p>
                </div>
                <div class="relative max-w-md w-full">
                    <input type="text" id="orderSearchInput" onkeyup="searchOrdersByName()" placeholder="🔍 Search orders by user name..." class="w-full p-3 rounded-xl nike-glass-input text-xs pl-9">
                </div>
            </div>

            <div class="overflow-x-auto max-h-[50vh] overflow-y-auto pr-1 custom-scroll">
                <table class="w-full text-left text-xs border-collapse min-w-[1350px]">
                    <thead>
                        <tr class="border-b border-white/20 text-white/60 font-semibold uppercase tracking-wider">
                            <th class="py-3 px-4">User Details</th>
                            <th class="py-3 px-4">Location (State/Dist/City)</th>
                            <th class="py-3 px-4">Address & PIN</th>
                            <th class="py-3 px-4">Product & Size</th>
                            <th class="py-3 px-4">Price & Date</th>
                            <th class="py-3 px-4 text-center">Status Control / Action</th>
                            <th class="py-3 px-4 text-center">Payment Proof</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTableBody">
                        <% if(typeof orders !== 'undefined' && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr class="order-item-row border-b border-white/5 hover:bg-white/5 transition-colors">
                                    
                                    <td class="py-3 px-4 customer-name-cell">
                                        <div class="font-bold text-white">
                                            <%= (order.customerDetails && order.customerDetails.name) ? order.customerDetails.name : 'Guest User' %>
                                        </div>
                                        <div class="text-[10px] text-white/50 mt-0.5">
                                            📱 <%= (order.customerDetails && order.customerDetails.phone) ? order.customerDetails.phone : 'N/A' %>
                                        </div>
                                    </td>

                                    <td class="py-3 px-4 text-white/80">
                                        <div class="font-medium text-white/90">
                                            <%= (order.customerDetails && order.customerDetails.state) ? order.customerDetails.state : 'N/A' %> 
                                            / 
                                            <%= (order.customerDetails && order.customerDetails.district) ? order.customerDetails.district : 'N/A' %>
                                        </div>
                                        <div class="text-[10px] text-white/50 mt-0.5">
                                            🏙️ <%= (order.customerDetails && order.customerDetails.city) ? order.customerDetails.city : 'N/A' %>
                                        </div>
                                    </td>
                                    
                                    <td class="py-3 px-4 text-white/80 max-w-[200px]">
                                        <div class="truncate" title="<%= (order.customerDetails && order.customerDetails.address) ? order.customerDetails.address : '' %>">
                                            <%= (order.customerDetails && order.customerDetails.address) ? order.customerDetails.address : 'No Address Provided' %>
                                        </div>
                                        <div class="text-[10px] font-bold text-yellow-400 mt-0.5">
                                            PIN: <%= (order.customerDetails && order.customerDetails.pincode) ? order.customerDetails.pincode : 'N/A' %>
                                        </div>
                                    </td>
                                    
                                    <td class="py-3 px-4 text-white/80">
                                        <div class="font-medium">
                                            <% if(order.items && order.items.length > 0) { %>
                                                <%= order.items[0].title || order.items[0].productName || order.items[0].name || 'Capsule Asset' %>
                                            <% } else { %>
                                                Capsule Asset
                                            <% } %>
                                        </div>
                                        <div class="mt-1">
                                            <span class="bg-white/10 border border-white/10 text-white px-2 py-0.5 rounded font-mono text-[10px]">
                                                Size: <%= (order.items && order.items.length > 0 && order.items[0].size) ? order.items[0].size : 'N/A' %>
                                            </span>
                                        </div>
                                    </td>
                                    
                                    <td class="py-3 px-4">
                                        <div class="font-semibold text-yellow-300">
                                            ₹<%= order.totalAmount || '0' %>
                                        </div>
                                        <div class="text-[10px] text-white/50 mt-0.5">
                                            <%= order.date ? new Date(order.date).toLocaleDateString() : 'N/A' %>
                                        </div>
                                    </td>

                                    <td class="py-3 px-4 text-center">
                                        <% if (order.status === 'cancelled') { %>
                                            <button class="bg-red-600 text-white text-[10px] font-bold px-3 py-1.5 rounded-xl uppercase tracking-wider shadow-md select-none cursor-default">
                                                🚫 Order Cancelled By User
                                            </button>
                                        <% } else if (order.status === 'rejected') { %>
                                            <span class="bg-red-500/20 text-red-300 border border-red-500/30 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase">
                                                ❌ Rejected By Owner
                                            </span>
                                        <% } else if (order.status === 'ordered') { %>
                                            <div class="flex gap-2 justify-center">
                                                <button onclick="updateOrderStatus('<%= order._id %>', 'accepted')" class="bg-green-600 hover:bg-green-700 text-white text-[11px] font-bold px-3 py-1.5 rounded-xl transition-all shadow-md">
                                                    Accept
                                                </button>
                                                <button onclick="updateOrderStatus('<%= order._id %>', 'rejected')" class="bg-red-500/20 hover:bg-red-600 text-red-300 hover:text-white border border-red-500/40 text-[11px] font-bold px-3 py-1.5 rounded-xl transition-all shadow-md">
                                                    Reject
                                                </button>
                                            </div>
                                        <% } else { %>
                                            <div class="flex items-center gap-1.5 justify-center">
                                                <select id="status-select-<%= order._id %>" class="bg-black/40 text-white text-[11px] border border-white/20 rounded-xl p-1.5 outline-none focus:border-white/50 cursor-pointer">
                                                    <option value="accepted" <%= order.status === 'accepted' ? 'selected' : '' %>>📦 Order packed</option>
                                                    <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>🚚 Shipped</option>
                                                    <option value="arriving_soon" <%= order.status === 'arriving_soon' ? 'selected' : '' %>>🕒 Arriving Soon</option>
                                                    <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>✅ Delivered</option>
                                                </select>
                                                <button onclick="updateOrderStatus('<%= order._id %>', document.getElementById('status-select-<%= order._id %>').value)" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-2.5 py-1.5 rounded-xl text-[10px] transition-all">
                                                    Update
                                                </button>
                                            </div>
                                        <% } %>
                                    </td>
                                    
                                    <td class="py-3 px-4 text-center">
                                        <% 
                                            let proof = order.paymentProof || (order.customerDetails && order.customerDetails.paymentProof); 
                                            if (proof && proof !== 'N/A' && proof !== '') {
                                                if (!proof.startsWith('/') && !proof.startsWith('http')) {
                                                    proof = '/' + proof;
                                                }
                                        %>
                                            <img src="<%= proof %>" 
                                                 alt="Payment Proof" 
                                                 class="w-12 h-12 rounded-lg cursor-pointer border border-white/20 mx-auto object-cover transition-transform hover:scale-110 shadow-md" 
                                                 onclick="openFullscreenImage('<%= proof %>')"
                                                 title="Click to view full screen">
                                        <% } else { %> 
                                            <span class="text-white/30 text-[10px] uppercase font-bold tracking-wide">No Proof</span> 
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="py-8 text-center text-white/40 font-medium">No customer checkout logs found in database.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="p-4 md:p-6 max-w-7xl mx-auto mt-4 mb-8">
        <h3 class="text-2xl font-bold text-white serif-title mb-6 flex items-center gap-2">
            <span>📦 Detailed Order Overview</span>
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if(typeof orders !== 'undefined' && orders.length > 0) { %>
                <% orders.forEach(order => { %>
                    <div class="nike-glass-panel p-5 rounded-2xl border border-white/10 hover:border-white/30 transition-all relative overflow-hidden group">
                        
                        <div class="border-b border-white/10 pb-3 mb-3 flex justify-between items-start">
                            <div>
                                <h4 class="font-bold text-lg text-white truncate pr-2">
                                    <%= (order.customerDetails && order.customerDetails.name) ? order.customerDetails.name : 'Guest User' %>
                                </h4>
                                <p class="text-xs text-white/60 mt-1">📞 <%= (order.customerDetails && order.customerDetails.phone) ? order.customerDetails.phone : 'N/A' %></p>
                            </div>
                            
                            <% if (order.status === 'cancelled') { %>
                                <span class="bg-red-600 text-white text-[9px] font-bold px-2 py-1 rounded shadow-md uppercase">Cancelled</span>
                            <% } else if (order.status === 'rejected') { %>
                                <span class="bg-red-500 text-white text-[9px] font-bold px-2 py-1 rounded shadow-md uppercase">Rejected</span>
                            <% } else if (order.status === 'ordered') { %>
                                <span class="bg-orange-500 text-white text-[9px] font-bold px-2 py-1 rounded shadow-md uppercase">New / Pending</span>
                            <% } else if (order.status === 'delivered') { %>
                                <span class="bg-green-600 text-white text-[9px] font-bold px-2 py-1 rounded shadow-md uppercase">Delivered</span>
                            <% } else { %>
                                <span class="bg-blue-500 text-white text-[9px] font-bold px-2 py-1 rounded shadow-md uppercase"><%= order.status %></span>
                            <% } %>
                        </div>
                        
                        <div class="space-y-2 text-xs text-white/80">
                            <div class="flex items-start gap-2">
                                <span class="text-white/40 min-w-[65px]">State/Dist:</span> 
                                <span class="font-medium"><%= (order.customerDetails && order.customerDetails.state) ? order.customerDetails.state : 'N/A' %>, <%= (order.customerDetails && order.customerDetails.district) ? order.customerDetails.district : 'N/A' %></span>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-white/40 min-w-[65px]">City/Vill:</span> 
                                <span class="font-medium"><%= (order.customerDetails && order.customerDetails.city) ? order.customerDetails.city : 'N/A' %></span>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-white/40 min-w-[65px]">Address:</span> 
                                <span class="font-medium leading-relaxed"><%= (order.customerDetails && order.customerDetails.address) ? order.customerDetails.address : 'N/A' %></span>
                            </div>
                            <div class="flex items-start gap-2">
                                <span class="text-white/40 min-w-[65px]">Pincode:</span> 
                                <span class="font-bold text-yellow-300"><%= (order.customerDetails && order.customerDetails.pincode) ? order.customerDetails.pincode : 'N/A' %></span>
                            </div>
                            <% if (order.status === 'cancelled' && order.cancellationReason) { %>
                                <div class="mt-2 pt-2 border-t border-white/5 text-red-300 italic text-[11px]">
                                    Reason: <%= order.cancellationReason %>
                                </div>
                            <% } %>
                        </div>

                        <div class="mt-4 pt-3 border-t border-white/10 bg-black/20 -mx-5 -mb-5 p-5">
                            <p class="text-white font-bold text-sm truncate">
                                <% if(order.items && order.items.length > 0) { %>
                                    👟 <%= order.items[0].title || order.items[0].productName || order.items[0].name || 'Capsule Asset' %>
                                <% } else { %>
                                    👟 Capsule Asset
                                <% } %>
                            </p>
                            <div class="flex justify-between items-center mt-2">
                                <span class="text-[10px] bg-white/10 px-2 py-1 rounded text-white/80">Size: <%= (order.items && order.items.length > 0 && order.items[0].size) ? order.items[0].size : 'N/A' %></span>
                                <span class="text-yellow-400 font-bold text-base">₹<%= order.totalAmount || '0' %></span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full p-8 text-center border border-dashed border-white/20 rounded-2xl text-white/40 font-medium">
                    No orders to display in detailed view.
                </div>
            <% } %>
        </div>
    </div>

    <script>
        // LIVE DYNAMIC STATUS LIFECYCLE MANAGEMENT API INTERACTION
        async function updateOrderStatus(orderId, targetStatus) {
            try {
                const response = await fetch(`/api/admin/orders/status/${orderId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: targetStatus })
                });

                const data = await response.json();
                if (data.success) {
                    openCustomModal('✅', 'Status Updated', `Order successfully tracked to: ${targetStatus}`);
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    openCustomModal('❌', 'Action Failed', data.message || 'Could not commit data logs to system.');
                }
            } catch (err) {
                console.error("Order process tracking update failure:", err);
                openCustomModal('⚠️', 'Server Error', 'Failed to connect with backend endpoints.');
            }
        }

        function showDeleteConfirm(productId) {
            const modal = document.getElementById('deleteConfirmModal');
            const deleteBtn = document.getElementById('confirmDeleteBtn');
            deleteBtn.setAttribute('href', `/admin/delete-product/${productId}`);
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.querySelector('.nike-glass-panel').classList.add('scale-100');
            modal.querySelector('.nike-glass-panel').classList.remove('scale-90');
        }

        function closeDeleteModal() {
            const modal = document.getElementById('deleteConfirmModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.querySelector('.nike-glass-panel').classList.add('scale-90');
            modal.querySelector('.nike-glass-panel').classList.remove('scale-100');
        }

        function addNewImageField() {
            const container = document.getElementById('image-inputs-container');
            if (container.getElementsByTagName('input').length >= 5) return;
            const uniqueId = 'img-' + Date.now();
            const wrapper = document.createElement('div');
            wrapper.id = uniqueId;
            wrapper.className = "flex gap-2 items-center";
            wrapper.innerHTML = `<input type="file" name="images" accept="image/*" class="w-full p-2 rounded-xl nike-glass-input text-xs cursor-pointer file:hidden"><button type="button" onclick="document.getElementById('${uniqueId}').remove()" class="text-red-400 font-bold text-sm">❌</button>`;
            container.appendChild(wrapper);
        }

        function openCustomModal(icon, title, msg) {
            const modal = document.getElementById('customModal');
            document.getElementById('modalIcon').innerText = icon;
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMessage').innerText = msg;
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeCustomModal() { document.getElementById('customModal').classList.add('opacity-0', 'pointer-events-none'); }

        function openSizePromptModal() {
            document.getElementById('sizePromptModal').classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeSizePromptModal() { document.getElementById('sizePromptModal').classList.add('opacity-0', 'pointer-events-none'); }

        function submitCustomSizeFromModal() {
            const val = document.getElementById('customSizeInputField').value.trim();
            if (val) {
                const container = document.getElementById('custom-sizes-container');
                container.classList.remove('hidden');
                const id = 's-' + Date.now();
                container.innerHTML += `<label id="${id}" class="flex items-center gap-1 font-bold text-white bg-white/10 p-1.5 rounded border border-white/20"><input type="checkbox" name="sizes" value="${val}" checked class="w-4 h-4"> ${val} <button type="button" onclick="document.getElementById('${id}').remove()" class="ml-auto text-[10px]">❌</button></label>`;
                closeSizePromptModal();
            }
        }

        function toggleSizeLayout(cat) {
            ['shoe-sizes', 'alpha-sizes', 'numeric-sizes'].forEach(id => {
                const block = document.getElementById(id);
                block.classList.add('hidden');
                block.querySelectorAll('input').forEach(input => input.disabled = true);
            });

            let activeId = '';
            if(cat === 'shoes') activeId = 'shoe-sizes';
            else if(['pants', 'shorts'].includes(cat)) activeId = 'numeric-sizes';
            else activeId = 'alpha-sizes';

            const activeBlock = document.getElementById(activeId);
            activeBlock.classList.remove('hidden');
            activeBlock.querySelectorAll('input').forEach(input => activeBlock.disabled = false);
        }

        function searchCatalogByTitle() {
            const val = document.getElementById('catalogSearchInput').value.toLowerCase();
            document.querySelectorAll('.catalog-product-card').forEach(card => {
                const title = card.querySelector('.product-title-text').innerText.toLowerCase();
                const catTag = card.querySelector('.category-tag').innerText.toLowerCase();
                card.style.display = (title.includes(val) || catTag.includes(val)) ? "" : "none";
            });
        }

        function searchOrdersByName() {
            const val = document.getElementById('orderSearchInput').value.toLowerCase();
            document.querySelectorAll('.order-item-row').forEach(row => {
                row.style.display = row.querySelector('.customer-name-cell').innerText.toLowerCase().includes(val) ? "" : "none";
            });
        }

        function openFullscreenImage(imageUrl) {
            const overlay = document.createElement('div');
            overlay.style.position = 'fixed';
            overlay.style.top = '0'; overlay.style.left = '0'; overlay.style.width = '100vw'; overlay.style.height = '100vh';
            overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.9)'; overlay.style.backdropFilter = 'blur(8px)';
            overlay.style.zIndex = '99999'; overlay.style.display = 'flex'; overlay.style.alignItems = 'center'; overlay.style.justifyContent = 'center'; overlay.style.cursor = 'zoom-out'; overlay.style.opacity = '0'; overlay.style.transition = 'opacity 0.25s ease';
            
            const img = document.createElement('img');
            img.src = imageUrl;
            img.style.maxWidth = '90%'; img.style.maxHeight = '90%'; img.style.objectFit = 'contain'; img.style.borderRadius = '12px';
            img.style.boxShadow = '0 25px 50px -12px rgba(0, 0, 0, 0.5)'; img.style.transform = 'scale(0.9)'; img.style.transition = 'transform 0.25s ease';
            
            overlay.appendChild(img);
            document.body.appendChild(overlay);
            
            setTimeout(() => { overlay.style.opacity = '1'; img.style.transform = 'scale(1)'; }, 10);
            overlay.onclick = () => { overlay.style.opacity = '0'; img.style.transform = 'scale(0.9)'; setTimeout(() => overlay.remove(), 250); };
        }
    </script>
</body>
</html>
